{
  "schema_version": 1,
  "project_id": "runner-validation-collaboration",
  "languages": [
    "python",
    "javascript"
  ],
  "implementation_mode": "collaboration",
  "files": [
    "python/sum_cli.py",
    "javascript/sum.mjs",
    "bridge.py"
