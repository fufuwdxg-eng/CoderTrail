    {
      "id": "version-python",
      "role": "version",
      "languages": [
        "python"
      ],
      "argv": [
        "{python}",
        "--version"
      ]
    },
    {
      "id": "behavior-python",
      "role": "test",
      "languages": [
        "python"
      ],
      "format": "cases",
      "argv": [
        "{python}",
        "python/sum_cli.py"
      ],
      "cases": [
        {
          "id": "positive",
          "category": "normal",
          "stdin": "2 3 5",
          "stdout": "10\n"
        },
        {
          "id": "signed",
          "category": "normal",
          "stdin": "-3 +4 0",
          "stdout": "1\n"
        },
        {
          "id": "empty",
          "category": "boundary",
          "stdin": "",
          "stdout": "0\n"
        },
        {
          "id": "boundaries",
          "category": "boundary",
          "stdin": "-1000 1000",
          "stdout": "0\n"
        },
        {
          "id": "malformed",
          "category": "error",
          "stdin": "2 nope",
          "stdout": "",
          "stderr": "INVALID\n",
          "exit_code": 2
        },
        {
          "id": "range",
          "category": "error",
          "stdin": "1001",
          "stdout": "",
          "stderr": "INVALID\n",
          "exit_code": 2
        },
        {
          "id": "ascii-whitespace",
          "category": "boundary",
          "stdin": " 1\t2\r\n3\u000b4\f5 ",
          "stdout": "15\n"
        },
        {
          "id": "unicode-separator",
          "category": "error",
          "stdin": "1 2",
          "stdout": "",
          "stderr": "INVALID\n",
          "exit_code": 2
        },
        {
          "id": "unicode-digit",
          "category": "error",
          "stdin": "１ 2",
          "stdout": "",
          "stderr": "INVALID\n",
          "exit_code": 2
        },
        {
          "id": "long-zero",
          "category": "boundary",
          "stdin": "",
          "stdout": "0\n"
        },
        {
          "id": "long-negative-zero-prefix",
          "category": "boundary",
          "stdin": "-",
          "stdout": "-12\n"
        },
        {
          "id": "bad-sign",
          "category": "error",
          "stdin": "--1",
          "stdout": "",
          "stderr": "INVALID\n",
          "exit_code": 2
        }
      ]
