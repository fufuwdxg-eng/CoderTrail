{
  "schema_version": 1,
  "project_id": "runner-validation-cpp",
  "languages": [
    "cpp"
  ],
  "implementation_mode": "single",
  "files": [
    "cpp/main.cpp"
  ],
  "steps": [
    {
      "id": "version",
      "role": "version",
      "languages": [
        "cpp"
      ],
      "argv": [
        "g++",
        "--version"
      ]
    },
    {
      "id": "compile",
      "role": "build",
      "languages": [
        "cpp"
      ],
      "argv": [
        "g++",
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-O2",
        "cpp/main.cpp",
        "-o",
        "program"
      ],
      "timeout_seconds": 30
    },
    {
      "id": "behavior",
      "role": "test",
      "languages": [
        "cpp"
      ],
      "format": "cases",
      "argv": [
        "./program"
      ],
      "cases": [
        {
          "id": "positive",
          "category": "normal",
          "stdin": "2 3 5",
          "stdout": "10\n"
        },
        {
          "id": "signed",
          "category": "normal",
          "stdin": "-3 +4 0",
          "stdout": "1\n"
        },
        {
          "id": "empty",
          "category": "boundary",
          "stdin": "",
          "stdout": "0\n"
        },
        {
          "id": "boundaries",
          "category": "boundary",
          "stdin": "-1000 1000",
          "stdout": "0\n"
        },
        {
          "id": "malformed",
          "category": "error",
          "stdin": "2 nope",
          "stdout": "",
          "stderr": "INVALID\n",
          "exit_code": 2
        },
        {
          "id": "range",
          "category": "error",
          "stdin": "1001",
          "stdout": "",
          "stderr": "INVALID\n",
          "exit_code": 2
        },
        {
          "id": "ascii-whitespace",
          "category": "boundary",
          "stdin": " 1\t2\r\n3\u000b4\f5 ",
          "stdout": "15\n"
        },
        {
          "id": "unicode-separator",
          "category": "error",
          "stdin": "1 2",
          "stdout": "",
          "stderr": "INVALID\n",
          "exit_code": 2
        },
        {
          "id": "unicode-digit",
          "category": "error",
          "stdin": "１ 2",
          "stdout": "",
          "stderr": "INVALID\n",
          "exit_code": 2
        },
        {
          "id": "long-zero",
          "category": "boundary",
          "stdin": "",
          "stdout": "0\n"
        },
        {
          "id": "long-negative-zero-prefix",
          "category": "boundary",
          "stdin": "-",
          "stdout": "-12\n"
        },
        {
          "id": "bad-sign",
          "category": "error",
          "stdin": "--1",
          "stdout": "",
          "stderr": "INVALID\n",
          "exit_code": 2
        }
      ]
    }
  ]
}
